[Unit]
Description=Metier — Find your calling, screen out the noise
After=network.target

[Service]
# Edit these three paths and the user to match your host
WorkingDirectory=/path/to/metier
EnvironmentFile=/path/to/metier/.env
ExecStart=/usr/bin/python3 /path/to/metier/app.py
Restart=always
RestartSec=5
User=youruser

[Install]
WantedBy=multi-user.target
